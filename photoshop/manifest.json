{
  "manifestVersion": 5,
  "id": "com.liquidglass.photoshop",
  "name": "Liquid Glass for Adobe",
  "version": "0.8.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.2.0"
  },
  "icons": [
    { "width": 24, "height": 24, "path": "icon.png", "scale": [1, 2], "theme": ["darkest", "dark", "light", "lightest", "all"], "species": ["pluginList"] }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "glassPanel",
      "label": {
        "default": "Liquid Glass for Adobe"
      },
      "icons": [
        { "width": 23, "height": 23, "path": "panel.png", "scale": [1, 2], "theme": ["darkest", "dark", "light", "lightest", "all"] }
      ],
      "minimumSize": {
        "width": 260,
        "height": 420
      },
      "maximumSize": {
        "width": 600,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 720
      },
      "preferredFloatingSize": {
        "width": 300,
        "height": 720
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "plugin",
    "launchProcess": {
      "schemes": [
        "https"
      ],
      "extensions": []
    }
  }
}
